{
  "name": "bodhi-pomodoro",
  "productName": "Bodhi Pomodoro",
  "version": "0.3.0",
  "description": "A Buddha desktop pet that meditates under the Bodhi tree for your focus session, then wakes and walks out for the break.",
  "main": "src/main.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node --test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.afzl.bodhipomodoro",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico"
    },
    "mac": {
      "publish": null
    },
    "linux": {
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bodhi Pomodoro",
      "uninstallDisplayName": "Bodhi Pomodoro"
    },
    "compression": "store",
    "publish": null,
    "extraMetadata": {
      "skipSign": "true"
    }
  },
  "author": "Afzal",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "png-to-ico": "^3.0.2",
    "@google/generative-ai": "^0.11.0",
    "openai": "^4.47.0"
  }
}