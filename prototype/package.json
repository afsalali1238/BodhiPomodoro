{
  "name": "bodhi-pomodoro",
  "productName": "Bodhi Pomodoro",
  "version": "0.3.0",
  "description": "A Buddha desktop pet that meditates under the Bodhi tree for your focus session, then wakes and walks out for the break.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "build": {
    "appId": "com.afzl.bodhipomodoro",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publish": null,
      "icon": "src/icon.ico"
    },
    "mac": {
      "publish": null
    },
    "linux": {
      "publish": null
    }
  },
  "author": "Afzal",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  }
}
